  import { FileSearch, Newspaper, Target, Users } from '@lucide/svelte';
</script>

<Slide variant="title">

<p class="slide-eyebrow">Truth-Telling 101 · Week 4</p>

# Peeling the onion

<p class="slide-subtitle slide-subtitle-wide">How reporters dig out the truth by working from the outside in</p>

</Slide>

<Slide variant="statement">

# Who are these men?

</Slide>

<Slide>

<img
  src="{base}/screenshots/peeling-the-onion/woodward-bernstein-1973.jpg"
